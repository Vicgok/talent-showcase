{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vigneshwaraak.co.in"
        }
      ],
      "destination": "https://www.vigneshwaraak.co.in/:path*",
      "permanent": true
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}
